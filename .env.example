# ============================================================================
#  .env.example — MẪU. Tạo .env bằng lệnh KHÔNG ghi đè (đã có .env thì GIỮ NGUYÊN):
#    PowerShell: if (!(Test-Path .env)) { Copy-Item .env.example .env }
#    Bash     : cp -n .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG được commit.
# ============================================================================
#
#  MÔ HÌNH CẤU HÌNH CỦA DỰ ÁN
#  ─────────────────────────────
#    • Giá trị DEFAULT nằm trong repo, ở appsettings*.json + docker-compose.dev.yml.
#      Default = giá trị chuẩn, dùng được ngay sau khi clone, không cần .env.
#    • Giá trị THẬT của từng máy nằm trong .env và chỉ ghi đè (override).
#    • Đã sửa .env rồi thì chạy:  docker compose -f docker-compose.dev.yml up -d
#      (đổi POSTGRES_PASSWORD trên volume đã tạo không có tác dụng, xem cuối file)
#
#  CẢ HAI LỚP ĐỀU ĐƯỢC ĐỌC:
#    - docker compose ....... tự nạp .env cho biến ${VAR:-default}
#    - API (dotnet run) .... EnvFileLoader nạp .env (src/backend/CulinaryBlog.API/EnvFileLoader.cs)
#      và bỏ qua khi ASPNETCORE_ENVIRONMENT=Production. Biến đã có sẵn (CI, $env:...)
#      luôn thắng .env.
#
#  MUỐN ĐỔI GÌ THÌ SỬA .env, ĐỪNG SỬA FILE ĐÃ COMMIT.
# ============================================================================

# --- Docker Compose devinfra -----------------------------------------------
# Không khai báo thì compose lấy default trong docker-compose.dev.yml (postgres).
POSTGRES_PASSWORD=postgres
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# Đổi S3_TAG thì BẮT BUỘC phải đổi S3_DIGEST theo, nếu không container không lên.
# Giữ nguyên cả hai để image luôn được ghim (ADR-TV4-002 §4.1, rủi ro R1).
S3_TAG=1.0.0
S3_DIGEST=sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff

# --- API (ASP.NET Core) -----------------------------------------------------
# Password ở đây PHẢI khớp POSTGRES_PASSWORD, nếu không sẽ 28P01 lúc migrate.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=culinary_blog;Username=postgres;Password=postgres

# BẮT BUỘC (QD3-3b): khóa ký JWT không còn nằm trong appsettings*.json.
# App sẽ KHÔNG KHỞI ĐỘNG nếu thiếu hoặc khóa < 64 byte — đây là hành vi đúng, đừng bỏ qua.
# Sinh khóa ngẫu nhiên MỘT LẦN rồi lưu vào .env (KHÔNG commit):
#   PowerShell : $b=New-Object byte[] 48; ([Security.Cryptography.RandomNumberGenerator]::Create()).GetBytes($b); [Convert]::ToBase64String($b)
#   Git Bash   : openssl rand -base64 48
# Dán kết quả (64 ký tự) vào dòng dưới. ĐỔI khóa = mọi phiên đăng nhập cũ mất hiệu lực.
Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_BYTES
Jwt__Issuer=culinary-blog
Jwt__Audience=culinary-blog-client

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Object storage (biến app đọc) ------------------------------------------
# RUSTFS_* ở trên là biến của container; Minio__* là cấu hình app dùng để gọi S3.
Minio__Endpoint=localhost:9000
Minio__Bucket=culinary-blog
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__UseSsl=false

# --- Health check ------------------------------------------------------------
# /health       : TCP probe — nhanh, lỗi sớm để dịch vụ chậm không kẹt đầu hàng.
# /health/ready : probe credential object storage THẬT + Redis + DB (N1-1/B4, commit a1311fa).
#   ⇒ Minio__* sai thì /health/ready trả 503 storage.unavailable ngay, thay vì báo Healthy rồi lỗi upload.
#   Lệnh so HealthChecks__Minio__* ở dưới CHỉ dùng cho TCP probe của /health.
HealthChecks__Redis__Host=localhost
HealthChecks__Redis__Port=6379
HealthChecks__Minio__Host=localhost
HealthChecks__Minio__Port=9000

# --- Database dùng cho test ------------------------------------------------
# Test đọc các biến này qua cùng EnvFileLoader. KHÔNG trỏ về culinary_blog.
TEST_DATABASE=Host=localhost;Port=5432;Database=culinary_test;Username=postgres;Password=postgres
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=culinary-blog

# --- Frontend ---------------------------------------------------------------
# Next.js KHÔNG đọc .env ở thư mục gốc. Phải tạo riêng src/frontend/.env.local:
#   NEXT_PUBLIC_API_URL=http://localhost:5080/api/v1
#   NEXT_PUBLIC_MEDIA_URL=http://localhost:5080/api/v1/resources/images
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
#  LƯU Ý KHI ĐỔI POSTGRES_PASSWORD
# ============================================================================
#  Volume `culinaryblog_pg_data` chỉ đọc POSTGRES_PASSWORD lúc KHỞI TẠO lần đầu.
#  Sửa .env sau đó KHÔNG đổi được mật khẩu đã nằm trong volume hiện có.
#  Cách đổi:
#    docker compose -f docker-compose.dev.yml exec postgres \
#      psql -U postgres -c "ALTER USER postgres WITH PASSWORD 'mat-khau-moi';"
#  Cách xoá sạch (MẤT TOÀN BỘ DỮ LIỆU dev):
#    docker compose -f docker-compose.dev.yml down -v
# ============================================================================
