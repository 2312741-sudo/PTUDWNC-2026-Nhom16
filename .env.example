# Template only — dotnet không tự nạp file này; copy thành .env khi cần hoặc dùng biến môi trường.
# LƯU Ý: .env KHÔNG được commit; file này chỉ là mẫu placeholder.

# --- API (ASP.NET) ---
# CHUẨN: dùng Docker Compose (password admin123 đồng bộ cả team).
# Nếu dùng PostgreSQL native, override local bằng biến này (KHÔNG sửa file đã commit).
ConnectionStrings__Database=Host=localhost;Port=5432;Database=culinary_blog;Username=postgres;Password=admin123
Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_BYTES
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- HealthCheck config (TCP probe dev, không phải runtime credential) ---
HealthChecks__Redis__Host=localhost
HealthChecks__Redis__Port=6379
HealthChecks__Minio__Host=localhost
HealthChecks__Minio__Port=9000

# --- MinIO contract (tuần 1 interface/contract, full client tuần 2) ---
Minio__Endpoint=localhost:9000
Minio__Bucket=culinary-blog
Minio__AccessKey=REPLACE_LOCALLY
Minio__SecretKey=REPLACE_LOCALLY

# --- Docker Compose devinfra (chỉ dùng khi chạy docker-compose.dev.yml) ---
# Giá trị mặc định trong compose là dev-only, KHÔNG dùng cho production.
# RUSTFS_* là biến của RustFS (thay cho image MinIO đã bị gỡ khỏi Docker Hub và quay.io);
# khối Minio__* ở trên là cấu hình app đọc, giữ nguyên cho dev.
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
S3_TAG=1.0.0
# Digest của đúng tag trên. Đổi S3_TAG thì phải đổi S3_DIGEST theo, nếu không container không khởi động.
# Giữ nguyên cả hai để image luôn được ghim (ADR-TV4-002 §4.1, rủi ro R1).
S3_DIGEST=sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
