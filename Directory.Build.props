<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- SixLabors.ImageSharp 3.1.11 dính 5 advisory (2026) và NuGet audit biến chúng thành lỗi
       NU1902/NU1903 vì TreatWarningsAsErrors=true. Bản đã vá (4.1.x) bắt buộc license thương mại
       cho build Release (SixLabors.ImageSharp.targets chặn CI), tức KHÔNG có bản vá miễn phí.
       => Chấp nhận rủi ro có ghi nhận: chỉ suppress các advisory này, vẫn giữ audit cho mọi
       advisory khác. Gỡ các dòng dưới khi có bản 3.x/4.x miễn phí. Chi tiết: security-hygiene. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
